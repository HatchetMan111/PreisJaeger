# Kopieren nach .env und Keys eintragen. Gesetzte Werte werden vom Installer nie ueberschrieben.
# Alle Keys sind OPTIONAL: Ohne Keys laeuft die Kernfunktion (Suche, Preissieger, Verlauf, Bestpreis) vollstaendig lokal.

# Webserver
PORT=8090
HOST=0.0.0.0

# Datenbank (SQLite-Datei)
DB_PATH=/opt/preisjaeger/data/searches.db

# Shop-Suche (IDs aus get-shops bzw. /api/shops; leer = alle EU-relevanten)
# SHOP_IDS=amazon-de,amazon-fr,amazon-it,amazon-es,ebay-com,ebay-fr,mydealz,dealabs
SHOP_IDS=
SHOP_TIMEOUT_MS=40000

# LLM: none (Standard, deterministisch, keine Cloud) oder openrouter
LLM_PROVIDER=none
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MAX_TOKENS=400
OPENROUTER_TIMEOUT_MS=20000

# Fallback wenn Shop-Suche 0 Treffer liefert: false oder brave
ENABLE_FALLBACK=false
BRAVE_API_KEY=
BRAVE_TIMEOUT_MS=15000
